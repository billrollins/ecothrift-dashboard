{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "backend",
      "runtimeExecutable": "venv/Scripts/python.exe",
      "runtimeArgs": [
        "manage.py",
        "runserver",
        "127.0.0.1:8000"
      ],
      "port": 8000
    },
    {
      "name": "public",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend-public",
        "run",
        "dev",
        "--",
        "--strictPort"
      ],
      "port": 5174
    },
    {
      "name": "fontlab",
      "runtimeExecutable": "venv/Scripts/python.exe",
      "runtimeArgs": [
        "workspace/posters2/fontlab/serve.py"
      ],
      "port": 5191
    },
    {
      "name": "posters",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5195",
        "--directory",
        "workspace/posters2/out/S"
      ],
      "port": 5195
    }
  ]
}
