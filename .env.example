# Edit `.env` (local) and `.envprod` (Heroku mirror) at the repo root.
# Push prod config:  scripts\deploy\env\sync_to_heroku.bat

# Online Sales (keep false in production until soft launch)
# ONLINE_SALES_ENABLED=false
# ONLINE_SALES_INQUIRIES_ENABLED=true
# ONLINE_SALES_ACCOUNTS_ENABLED=true
# ONLINE_SALES_REQUEST_TRIAGE_HOURS=48
# Local magic-link / hold emails need a clickable host:
# ONLINE_SALES_PUBLIC_BASE_URL=http://localhost:5174
