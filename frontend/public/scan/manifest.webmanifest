{
  "id": "/qr",
  "name": "Thrift+ Member",
  "short_name": "Thrift+",
  "start_url": "/scan",
  "scope": "/",
  "display": "standalone",
  "handle_links": "preferred",
  "launch_handler": { "client_mode": ["navigate-existing", "auto"] },
  "background_color": "#f2f2ee",
  "theme_color": "#237a26",
  "icons": [
    {
      "src": "/scan/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/scan/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/scan/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "orientation": "portrait"
}
