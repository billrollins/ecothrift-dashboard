{# Eco-Thrift sign pictograms (Dash Update #134, brand board v1). One style for every theme:
   solid shapes on a 100 x 100 grid, square ends, cut-outs in the background colour, parts 7 to 12 units thick,
   at least 6 units of air between parts, no faces, hands or other detail. One colour per glyph: ink (or a dark swatch)
   on light, white on dark. Usage: {% import 'brand-icons.html.j2' as bi %} {{ bi.icon('restroom', '#1b1f1b', '#fff') }}
   Names: restroom, noentry, camera, id, hours, returns, staff, exit, alert. Spanish labels: LABELS below. #}

{% set LABELS = {
  'restroom': ('Restroom', 'Baños'),
  'noentry': ('No entry', 'Prohibido el paso'),
  'camera': ('On camera', 'Videovigilancia'),
  'id': ('ID check', 'Identificación'),
  'hours': ('Hours', 'Horario'),
  'returns': ('Returns', 'Devoluciones'),
  'staff': ('Staff', 'Personal'),
  'exit': ('Exit', 'Salida'),
} %}

{% macro glyph(name, c, bg) -%}
{%- if name == 'restroom' %}
  <rect x="48.5" y="6" width="3" height="88" fill="{{ c }}"/>
  <circle cx="25" cy="15" r="8.5" fill="{{ c }}"/>
  <path d="M15 28 H35 a5 5 0 0 1 5 5 V62 H10 V33 a5 5 0 0 1 5 -5 Z" fill="{{ c }}"/>
  <rect x="12" y="62" width="9" height="30" fill="{{ c }}"/>
  <rect x="29" y="62" width="9" height="30" fill="{{ c }}"/>
  <circle cx="75" cy="15" r="8.5" fill="{{ c }}"/>
  <path d="M66 28 H84 L94 66 H56 Z" fill="{{ c }}"/>
  <rect x="64" y="66" width="8" height="26" fill="{{ c }}"/>
  <rect x="78" y="66" width="8" height="26" fill="{{ c }}"/>
{%- elif name == 'noentry' %}
  <circle cx="50" cy="50" r="46" fill="{{ c }}"/>
  <rect x="19" y="41" width="62" height="18" fill="{{ bg }}"/>
{%- elif name == 'camera' %}
  <g transform="translate(2 8)">
    <g transform="rotate(-15 48 38)">
      <rect x="12" y="22" width="72" height="9" fill="{{ c }}"/>
      <rect x="18" y="29" width="60" height="23" fill="{{ c }}"/>
      <rect x="7" y="33" width="12" height="16" fill="{{ c }}"/>
    </g>
    <path d="M58 48 V68 H82" fill="none" stroke="{{ c }}" stroke-width="9"/>
    <rect x="80" y="55" width="10" height="26" fill="{{ c }}"/>
  </g>
{%- elif name == 'id' %}
  <rect x="5" y="19" width="90" height="62" rx="7" fill="{{ c }}"/>
  <circle cx="29" cy="41" r="9.5" fill="{{ bg }}"/>
  <path d="M13 71 a16 15 0 0 1 32 0 Z" fill="{{ bg }}"/>
  <rect x="52" y="35" width="33" height="7" fill="{{ bg }}"/>
  <rect x="52" y="48" width="33" height="7" fill="{{ bg }}"/>
  <rect x="52" y="61" width="21" height="7" fill="{{ bg }}"/>
{%- elif name == 'hours' %}
  <circle cx="50" cy="50" r="46" fill="{{ c }}"/>
  <circle cx="50" cy="50" r="36" fill="{{ bg }}"/>
  <rect x="46" y="22" width="8" height="32" fill="{{ c }}"/>
  <rect x="46" y="46" width="26" height="8" fill="{{ c }}"/>
  <rect x="47.5" y="16" width="5" height="5" fill="{{ c }}"/>
  <rect x="47.5" y="79" width="5" height="5" fill="{{ c }}"/>
  <rect x="16" y="47.5" width="5" height="5" fill="{{ c }}"/>
  <rect x="79" y="47.5" width="5" height="5" fill="{{ c }}"/>
{%- elif name == 'returns' %}
  <path d="M37 36 V28 a13 13 0 0 1 26 0 V36" fill="none" stroke="{{ c }}" stroke-width="7"/>
  <rect x="14" y="34" width="72" height="60" rx="5" fill="{{ c }}"/>
  <path d="M68 82 V66 a11 11 0 0 0 -11 -11 H42" fill="none" stroke="{{ bg }}" stroke-width="8"/>
  <path d="M45 42 L29 55 L45 68 Z" fill="{{ bg }}"/>
{%- elif name == 'staff' %}
  <circle cx="50" cy="24" r="17" fill="{{ c }}"/>
  <path d="M12 96 V80 a27 27 0 0 1 27 -27 H61 a27 27 0 0 1 27 27 V96 Z" fill="{{ c }}"/>
  <path d="M39 53 L50 70 L61 53" fill="none" stroke="{{ bg }}" stroke-width="4"/>
  <rect x="42" y="70" width="16" height="13" rx="2" fill="{{ bg }}"/>
{%- elif name == 'exit' %}
  <path d="M50 26 V9 H11 V91 H50 V74" fill="none" stroke="{{ c }}" stroke-width="9"/>
  <rect x="28" y="44" width="46" height="12" fill="{{ c }}"/>
  <path d="M70 30 L95 50 L70 70 Z" fill="{{ c }}"/>
{%- elif name == 'alert' %}
  <path d="M50 5 L97 90 H3 Z" fill="{{ c }}" stroke="{{ c }}" stroke-width="3" stroke-linejoin="round"/>
  <path d="M44 34 H56 L54 64 H46 Z" fill="{{ bg }}"/>
  <circle cx="50" cy="76" r="6.5" fill="{{ bg }}"/>
{%- endif %}
{%- endmacro %}

{% macro icon(name, c='#1b1f1b', bg='#ffffff', cls='pic') -%}
<svg class="{{ cls }}" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">{{ glyph(name, c, bg) }}</svg>
{%- endmacro %}
