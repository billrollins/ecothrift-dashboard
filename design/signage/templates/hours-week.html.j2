{% extends 'base.html.j2' %}
{# C. Week grid: the logo, "Store hours", seven equal rows (day left, hours right); the closed day greyed. #}
{% block style %}
.wrap { position: absolute; inset: 0.6rem 0.65rem 0.55rem; display: flex; flex-direction: column; align-items: center; }
.logo { width: 4.6rem; }
h1 { margin-top: 0.38rem; font-size: 0.62rem; font-weight: 800; color: var(--forest); }
.grid { flex: 1; width: 100%; margin: 0.38rem 0 0.32rem; display: grid; grid-template-rows: repeat(7, 1fr);
        border-top: 0.03rem solid var(--forest); border-bottom: 0.03rem solid var(--forest); }
.row { display: flex; align-items: center; justify-content: space-between; padding: 0 0.22rem;
       border-bottom: 0.015rem solid var(--rule); }
.row:last-child { border-bottom: none; }
.row:nth-child(odd) { background: var(--mint); }
.day { font-size: 0.42rem; font-weight: 800; display: flex; align-items: center; gap: 0.16rem; }
.tag { background: var(--sun); color: var(--forest); font-size: 0.17rem; font-weight: 800; letter-spacing: 0.06em;
       text-transform: uppercase; padding: 0.04rem 0.12rem; border-radius: 0.2rem; }
.hrs { font-size: 0.44rem; color: var(--forest); white-space: nowrap; }
.hrs .to { font-family: 'Manrope', sans-serif; font-weight: 700; font-size: 0.26rem; color: var(--ink); margin: 0 0.06rem; }
.row.closed { background: var(--page); }
.row.closed .day, .row.closed .hrs { color: var(--muted); }
.foot { font-size: 0.28rem; font-weight: 700; color: var(--forest); }
{% endblock %}
{% block body %}
<div class="wrap">
  <img class="logo" src="{{ art }}/logos/eco-full-color.png" alt="Eco-Thrift">
  <h1>{{ title }}</h1>
  <div class="grid">
    {% for d in hours.days %}
    <div class="row{% if d.closed %} closed{% endif %}">
      <div class="day">{{ d.day }}{% if v.new_monday and d.day == 'Monday' and not d.closed %}<span class="tag">{{ new_tag }}</span>{% endif %}</div>
      {% if d.closed %}<div class="hrs num">Closed</div>
      {% else %}<div class="hrs num">{{ d.open }}<span class="to">to</span>{{ d.close }}</div>{% endif %}
    </div>
    {% endfor %}
  </div>
  <div class="foot">{{ site }}</div>
</div>
{% endblock %}
